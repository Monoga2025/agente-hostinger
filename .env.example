# Configuración de Conexión SFTP / SSH para Hostinger
# IMPORTANTE: No almacenar contraseñas reales en este archivo ni en el repositorio.
# Copiar este archivo a .env y configurar las credenciales locales.

HOSTINGER_SFTP_HOST=<IP_o_hostname_de_SSH_Access>
HOSTINGER_SFTP_PORT=65002
HOSTINGER_SFTP_USERNAME=<usuario_FTP_SSH>
HOSTINGER_SFTP_PASSWORD=<contraseña_exclusiva_para_el_agente>

# Dominio y Rutas Permitidas (Protección contra Path Traversal)
HOSTINGER_TARGET_DOMAIN=<dominio_inicial>
HOSTINGER_ALLOWED_ROOTS=/domains/<dominio>/public_html

# Directorio local para almacenamiento de backups automáticos y fechados
HOSTINGER_BACKUP_DIR=./backups

# Huella digital de la clave del servidor SSH (opcional/recomendado para MITM protection)
HOSTINGER_SSH_HOST_KEY_FINGERPRINT=<verificar_en_primera_conexion>

# Configuración de Dominios Múltiples (opcional, formato: dominio1:ruta1,dominio2:ruta2)
# HOSTINGER_DOMAINS=grupomonoga.com:/home/u000000000/domains/grupomonoga.com/public_html
